{
  "openapi": "3.0.3",
  "info": {
    "title": "Object Cache API",
    "version": "v1",
    "description": "Key-based cache store for lists of arbitrary objects, with configurable TTL."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Reports whether the service can handle requests.",
        "responses": {
          "200": {
            "description": "The service is healthy.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/v1/cache": {
      "post": {
        "summary": "Creates a new cache entry. Fails if the key already exists (and hasn't expired).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRequest" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "patch": {
        "summary": "Appends values to an existing entry and extends its TTL. Does not create new entries.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppendRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Entry" },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "delete": {
        "summary": "Deletes a cache entry by key.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteRequest" } } }
        },
        "responses": {
          "204": { "description": "Entry deleted." },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/cache/{key}": {
      "get": {
        "summary": "Retrieves a cache entry by key, if present and not expired.",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          {
            "name": "extendTtl",
            "in": "query",
            "description": "When true, extends the entry's TTL (adding onto its current expiry) as a side effect of the read.",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "ttlSeconds",
            "in": "query",
            "description": "Seconds to extend by when extendTtl is true. Defaults to the configured default TTL.",
            "schema": { "$ref": "#/components/schemas/TtlSeconds" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Entry" },
          "400": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Created": {
        "description": "Entry created.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntryResponse" } } }
      },
      "Entry": {
        "description": "Success.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntryResponse" } } }
      },
      "Problem": {
        "description": "Error, as RFC 9457 problem details.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Key": { "type": "string", "minLength": 1, "maxLength": 256 },
      "Values": { "type": "array", "minItems": 1, "maxItems": 1000, "items": {} },
      "TtlSeconds": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2147483647 },
      "CreateRequest": {
        "type": "object",
        "required": ["key", "values"],
        "properties": {
          "key": { "$ref": "#/components/schemas/Key" },
          "values": { "$ref": "#/components/schemas/Values" },
          "ttlSeconds": { "$ref": "#/components/schemas/TtlSeconds" }
        }
      },
      "AppendRequest": {
        "type": "object",
        "required": ["key", "values"],
        "properties": {
          "key": { "$ref": "#/components/schemas/Key" },
          "values": { "$ref": "#/components/schemas/Values" },
          "ttlSeconds": { "$ref": "#/components/schemas/TtlSeconds" }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "required": ["key"],
        "properties": { "key": { "$ref": "#/components/schemas/Key" } }
      },
      "EntryResponse": {
        "type": "object",
        "required": ["key", "values", "expiresAtUtc"],
        "properties": {
          "key": { "type": "string" },
          "values": { "type": "array", "items": {} },
          "expiresAtUtc": { "type": "string", "format": "date-time" }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  }
}
